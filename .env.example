# Serveur
PORT=3000
APP_URL=http://localhost:3000

# Anthropic (chat du widget)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Dashboard admin — choisis un token long et privé, c'est ton mot de passe
ADMIN_TOKEN=change-moi-en-un-secret-long-et-aleatoire

# Stripe (facturation) — laisse vide pour tester sans paiement (essai seul)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PRICE_ID=your_stripe_price_id_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here